# =================================================================
# AutoKT Platform Environment Variables Example
# Copy this file to .env and replace placeholder values with your setup.
# =================================================================

# LLM Provider Configuration ("stub" | "gemini" | "azure_openai" | "azure_foundry")
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-5-mini

# Azure OpenAI Configuration (Only used if LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Graph Database Configuration (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_strong_password_here

# Relational Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autokt
DATABASE_URL=postgresql://postgres:your_strong_password_here@localhost:5432/autokt

# Vector Database Configuration (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Source-only reverse-engineering demo
REVERSE_ENGINEERING_ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
REVERSE_ENGINEERING_WORK_ROOT=tmp_reverse_engineering
REVERSE_ENGINEERING_ARTIFACT_ROOT=artifacts/reverse_engineering
REVERSE_ENGINEERING_MAX_FILES=20000
REVERSE_ENGINEERING_MAX_FILE_BYTES=2097152
REVERSE_ENGINEERING_MAX_SOURCE_BYTES=52428800
REVERSE_ENGINEERING_LLM_ENRICHMENT=true
REVERSE_ENGINEERING_MAX_CORRECTION_ROUNDS=2
REVERSE_ENGINEERING_MAX_BUNDLE_BYTES=104857600
REVERSE_ENGINEERING_STALE_TASK_MINUTES=0
REVERSE_ENGINEERING_KEEP_CHECKOUTS=false

# Security & Authentication Secrets (MUST be overridden in production)
JWT_SECRET=generate_a_random_64char_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Embedding Provider ("nomic")
EMBEDDING_PROVIDER=nomic

# Cross-Encoder Reranker ("cross-encoder" | "disabled" | "stub")
RERANKER_PROVIDER=cross-encoder
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
